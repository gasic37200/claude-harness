#!/bin/sh
# harness: 기본 브랜치(main · master)에 직접 push 하는 것을 막는다.
# 급할 때는 HARNESS_SKIP=1 git push ... 로 건너뛴다. 반드시 막아야 하는 건 GitHub 브랜치 보호(ruleset)에 둔다.
[ "$HARNESS_SKIP" = "1" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "harness: ${remote_ref#refs/heads/} 에 직접 push 할 수 없습니다. 브랜치를 만들어 PR로 올려 주세요." >&2
      echo "harness: 꼭 필요하면 HARNESS_SKIP=1 git push ..." >&2
      exit 1
      ;;
  esac
done
exit 0
